{
  "style": "Dark fantasy pixel art — dark purple/blue tones, bright character accents",
  "gridSize": "8x8 (rendered at 20x20 tile)",
  "palette": {
    "wall-dark": "#1e1638",
    "wall-lit": "#362a5c",
    "wall-top": "#4a3a7a",
    "floor-dark": "#0d0b1a",
    "floor-lit": "#201c3a",
    "player": "#4ef",
    "attack": "#fa4",
    "health": "#f4a",
    "mana": "#48f",
    "gold": "#fd4",
    "magic": "#f4f",
    "damage": "#f44",
    "heal": "#4f4"
  },
  "frameConvention": {
    "enemies": "frame 0 = alive, frame 1 = dead/destroyed variant",
    "player": "frame 0 = base, frame 1 = shielded/buffed",
    "tiles": "frames for visual variants (e.g. normal, damaged, lit)"
  },
  "categories": {
    "tiles": {
      "sprites": ["wall", "wallLit", "floor", "floorLit", "stairs"],
      "desc": "Dungeon tiles — walls, floors, stairs"
    },
    "enemies": {
      "sprites": ["rat", "phantom", "mage", "armor", "golem", "archmage"],
      "desc": "Monsters — small to boss. Each sprite has alive (frame 0) and dead (frame 1) variants"
    },
    "items": {
      "sprites": ["potion", "mana", "gold", "weapon", "armor", "spellbook"],
      "desc": "Collectible items"
    },
    "player": {
      "sprites": ["base", "shielded"],
      "desc": "Player character"
    },
    "effects": {
      "sprites": ["hit", "heal", "spell"],
      "desc": "Visual effects for combat and magic"
    }
  }
}
