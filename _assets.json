{
  "style": "Dark dungeon pixel art — dark purple/blue tones, bright character accents",
  "gridSize": "8x8 (rendered at 20x20 tile)",
  "palette": {
    "wall-dark": "#2d2d44",
    "wall-cap": "#3d3d5c",
    "wall-face": "#2a2248",
    "floor-dark": "#0a0a12",
    "floor-alt": "#0f0d1c",
    "player": "#4fc3f7",
    "gold": "#ffd54f",
    "potion": "#e91e63",
    "stairs": "#4caf50",
    "damage": "#ef5350",
    "heal": "#4caf50"
  },
  "frameConvention": {
    "enemies": "frame 0 = alive, frame 1 = dead variant",
    "player": "frame 0 = base",
    "items": "frame 0 = default"
  },
  "categories": {
    "enemies": {
      "sprites": ["rat", "snake", "golem"],
      "desc": "Monsters matching data.js types — rat (brown), snake (green), golem (grey)"
    },
    "items": {
      "sprites": ["gold", "potion"],
      "desc": "Collectibles — gold coin, health potion"
    },
    "player": {
      "sprites": ["base"],
      "desc": "Player character — cyan accent"
    }
  }
}
